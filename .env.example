# Friday's secrets and per-house settings. scripts/install.sh copies this to
# .env; git ignores .env, so nothing here is ever committed.
# Every line is optional. Blank = feature off or asked for later.

# ---- Pairing code -----------------------------------------------------------
# Every phone and browser types this once. Left blank, Friday makes one at first
# start, prints it in the log, and saves it here.
API_TOKEN=

# ---- The AI model (local by default) --------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=house-qwen
LLM_API_KEY=ollama
# Cloud models are optional and chosen in Settings > Assistant model, which
# saves the key here. Using one sends your conversations to that company.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ---- Speech (local containers from docker-compose.tts.yml) ----------------
STT_BASE_URL=http://127.0.0.1:8001/v1
STT_MODEL=Systran/faster-whisper-large-v3
STT_API_KEY=local
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_MODEL=tts-1
# British: bf_isabella, bf_alice, bf_emma, bf_lily. American: af_bella, af_heart, af_sarah.
TTS_VOICE=bf_isabella
TTS_API_KEY=local
TTS_RESPONSE_FORMAT=mp3
TTS_SPEED=1.25

# ---- TV (optional; easier: Settings > House > Scan network) ------------------
# The TV's own address from Settings > Network > About, not the router's.
# ROKU_IP_ADDRESS=192.168.0.150
# ROKU_DEVICE_ID=living-room
# ROKU_DEVICE_NAME=Living Room TV

# ---- Movies and shows: "play The Bear", "find me a 90s horror movie" -------
# Free keys. See the README section "Getting API keys".
CATALOG_REGION=US
TMDB_READ_ACCESS_TOKEN=
WATCHMODE_API_KEY=
EXACT_EPISODE_PLAYBACK_ENABLED=false

# ---- Weather and directions (no key needed) --------------------------------
# Leave blank and Friday asks once where you live.
HOUSE_LATITUDE=
HOUSE_LONGITUDE=
WEATHER_PLACE=home
WEATHER_UNITS=imperial
WEATHER_ALERTS_ENABLED=true
# Optional: live traffic on driving times (free, developer.tomtom.com).
TOMTOM_API_KEY=
# Optional: a backup routing service (free, openrouteservice.org).
OPENROUTESERVICE_API_KEY=

# ---- Calendars you already use (read-only) ---------------------------------
# Private iCal links, comma-separated. See README "Connecting calendars".
# CALENDAR_ICS_URLS=

# ---- Travel: flights and hotels (letsfg.co) --------------------------------
# Hotels need nothing. Flights: run `letsfg auth` once (see README).
LETSFG_BEARER_TOKEN=
TRAVEL_CURRENCY=USD

# ---- DoorDash (optional, see README) ---------------------------------------
# Only on a machine with no keychain: output of `dd-cli export-token`.
# DD_CLI_ACCESS_TOKEN=

# ---- Smart devices ---------------------------------------------------------
# Your Wi-Fi, handed to brand-new Matter devices when pairing over Bluetooth.
HOUSE_WIFI_SSID=
HOUSE_WIFI_PASSWORD=
# Zigbee USB dongle. Find yours with: ls /dev/serial/by-id/
# ZIGBEE_DONGLE=/dev/serial/by-id/usb-SONOFF_..._if00-port0
# Time zone for the Zigbee container, e.g. America/New_York
# TZ=America/New_York
